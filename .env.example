APP_NAME="Attendance System"
APP_ENV=production
APP_KEY=YoP9W2gtOQQ1wz5K2MhNF4cApNo0Vs73VrVoY
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---- Company work-hours configuration used for late / overtime calculation ----
COMPANY_WORK_START=09:00
COMPANY_WORK_END=18:00
COMPANY_LATE_GRACE_MINUTES=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database ----
DB_CONNECTION=pgsql
DB_URL=

# ---- Session / Cache / Queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Storage ----
FILESYSTEM_DISK=public
ATTENDANCE_PHOTOS_DISK=public

# ---- AWS / S3-compatible storage ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail ----
# Sending via Resend's HTTPS API (not SMTP) — Render's free web services
# block outbound SMTP ports entirely, so smtp.gmail.com etc. cannot connect
# from a free-plan service. Resend works because it's a normal HTTPS call.
# Sign up free at https://resend.com and create an API key.
# IMPORTANT: without verifying a domain you own on Resend, you can only
# send FROM onboarding@resend.dev, and it will only actually deliver TO the
# email address you signed up to Resend with — fine for testing/demo use,
# not for real end users until you verify a domain.
MAIL_MAILER=resend
RESEND_API_KEY=${{ secrets.RESEND_API }}
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=260031944633-30g214lri7b99q4unlbemmiof31aktip.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://imsm-uitmpg2-backend.onrender.com/auth/google/callback

# ---- Frontend ----
FRONTEND_URL=https://imsm-uitmpg-2-front-end.vercel.app/

VITE_APP_NAME="${APP_NAME}"
