APP_NAME="Attendance System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---- Company work-hours configuration used for late / overtime calculation ----
COMPANY_WORK_START=09:00
COMPANY_WORK_END=18:00
COMPANY_LATE_GRACE_MINUTES=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database ----
# Local dev: SQLite is fine.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Render (production): use Postgres, since Render's local disk is ephemeral
# and would wipe a SQLite file on every redeploy. Render gives you a single
# "Internal Database URL" for its managed Postgres — paste it into DB_URL.
# DB_CONNECTION=pgsql
# DB_URL=postgres://user:password@host:5432/dbname

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Disk used to store clock-in/out selfie photos. "public" is fine for local
# dev, but Render's disk is ephemeral — see DEPLOYMENT.md before relying on
# it in production. Switch to "s3" once you've configured an S3-compatible
# bucket below (AWS S3 / Cloudflare R2 / DigitalOcean Spaces all work).
ATTENDANCE_PHOTOS_DISK=public

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- CORS: the deployed Vercel frontend origin(s), comma-separated ----
# Any https://*.vercel.app preview URL is allowed automatically as well.
FRONTEND_URL=http://localhost:5500

VITE_APP_NAME="${APP_NAME}"
