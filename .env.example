APP_NAME="Attendance System"
APP_ENV=production
APP_KEY=YoP9W2gtOQQ1wz5K2MhNF4cApNo0Vs73VrVoY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---- Company work-hours configuration used for late / overtime calculation ----
COMPANY_WORK_START=09:00
COMPANY_WORK_END=18:00
COMPANY_LATE_GRACE_MINUTES=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database ----
DB_CONNECTION=pgsql
DB_URL=

# ---- Session / Cache / Queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Storage ----
FILESYSTEM_DISK=public
ATTENDANCE_PHOTOS_DISK=public

# ---- AWS / S3-compatible storage ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Frontend ----
FRONTEND_URL=https://your-app.vercel.app

VITE_APP_NAME="${APP_NAME}"
